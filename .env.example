# 复制为 .env.local 后按需修改

# ---- 服务端（Vite 开发代理用）----
# Spring Boot 后端
API_TARGET=http://localhost:8015
# 本地模型 origin（OpenAI 兼容），代理 /v1 → 它
MODEL_ORIGIN=http://localhost:1235

# ---- 客户端（打进前端产物）----
# backend：走 Spring Boot 的 /api/chat
# model  ：直连本地模型的 /v1/chat/completions
VITE_CHAT_MODE=backend
# 留空自动探测
VITE_MODEL_NAME=
# 默认 /api/chat
# VITE_CHAT_ENDPOINT=/api/chat
